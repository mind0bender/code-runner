{
  "name": "@mind0bender/code-runner",
  "version": "1.0.2",
  "description": "A blazing fast code runner powered by Bun.",
  "keywords": [
    "bun",
    "code-runner",
    "execute",
    "runtime"
  ],
  "license": "MIT",
  "author": "Yash Gupta",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "bun": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "default": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --minify"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
